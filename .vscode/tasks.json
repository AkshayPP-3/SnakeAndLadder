
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Snake and Ladder",
            "type": "process",
            "command": "C:/raylib/w64devkit/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-o",
                "${workspaceFolder}/SnakeAndLadder.exe",
                "${workspaceFolder}/src/main.cpp",
                "-I",
                "C:/raylib/w64devkit/include",
                "-L",
                "C:/raylib/w64devkit/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Snake and Ladder",
            "type": "process",
            "command": "${workspaceFolder}/SnakeAndLadder.exe",
            "dependsOn": "Build Snake and Ladder",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
